# ==============================================================================
# EPCRAS Environment Configuration Template
# ==============================================================================
# Instructions: Copy this file to .env and configure values before starting the application:
#   cp .env.example .env
#   chmod 600 .env
#
# NOTE: Do NOT commit the populated .env file containing production secrets to Git!
# ==============================================================================

# Flask Environment Mode
# Options: production | development | testing
FLASK_CONFIG=production

# Application Secret Key
# REQUIRED IN PRODUCTION: Generate a secure 32-byte secret key with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-secure-random-32-byte-hex-string-for-production

# Database Connection URI
# SQLite is fully supported for standard low-resource and academic deployments.
# Default SQLite location: instance/epcras.db
# PostgreSQL syntax example: postgresql://epcras_user:dbpassword@localhost:5432/epcras_db
DATABASE_URL=sqlite:///instance/epcras.db

# Cookie & Session Security
# Set to 'true' when serving over HTTPS/TLS (via Nginx or reverse proxy).
# Set to 'false' if running on plain HTTP (e.g., local development or internal lab).
SESSION_COOKIE_SECURE=false

# Session inactivity timeout (in minutes)
SESSION_LIFETIME_MINUTES=30

# CSRF token validity limit (in seconds, default 3600 = 1 hour)
WTF_CSRF_TIME_LIMIT=3600

# Reverse Proxy (Nginx / Apache / Caddy) Integration
# Enables Werkzeug's ProxyFix to correctly interpret X-Forwarded-For and X-Forwarded-Proto
USE_PROXY_FIX=true
PROXY_FIX_FOR=1
PROXY_FIX_PROTO=1
PROXY_FIX_HOST=1
PROXY_FIX_PREFIX=1

# Application Logging
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Optional: Path to application log file (rotating 10MB logs, 5 backups).
# Leave commented out to log directly to stdout/stderr (ideal for systemd journald).
LOG_FILE=instance/logs/epcras.log

# Gunicorn Deployment Configuration (used by systemd service or startup scripts)
GUNICORN_BIND=127.0.0.1:8000
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
